# Copiez ce fichier en .env pour le développement local (ne jamais committer .env).
# Sur Render, renseignez ces valeurs dans l’onglet « Environment » du service.

# URL du projet Supabase (Settings > API > Project URL)
SUPABASE_URL=https://VOTRE-PROJET.supabase.co

# Clé ANONYME uniquement (Settings > API > anon / publishable).
# NE JAMAIS utiliser la clé service_role ni une clé sb_secret_… : le serveur les refuse.
SUPABASE_ANON_KEY=

# Port d’écoute (Render le fournit automatiquement)
PORT=3000
