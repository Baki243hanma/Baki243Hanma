# Copiez ce fichier en .env pour le développement local (ne jamais committer .env).
# Sur Render, renseignez ces valeurs dans l’onglet « Environment » du service.

# Chaîne de connexion de la base Neon (Neon Console > Connect). SECRÈTE : serveur uniquement.
# Ne jamais la mettre dans le code, dans le navigateur ni dans VITE_*.
DATABASE_URL=postgresql://UTILISATEUR:MOT_DE_PASSE@HOTE.neon.tech/neondb?sslmode=require

# URL publique de Neon Auth (Neon Console > Auth > URL de base). Non secrète.
NEON_AUTH_URL=https://VOTRE-PROJET.neonauth.REGION.aws.neon.tech/neondb/auth

# Applique les migrations (db/migrations) au démarrage du serveur. Recommandé : true.
MIGRATE_ON_START=true

# Port d’écoute (Render le fournit automatiquement)
PORT=3000
