    "dexie-react-hooks": "^4.4.0",
    "express": "^5.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^7.3.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
